{
  "name": "ai-council",
  "compatibility_date": "2026-09-18",
  "main": "src/worker.js",

  // ============================================
  // AI 綁定 (Cloudflare AI)
  // ============================================
  // 名稱必須是 "AI"，src/debate.js 讀的是 env.AI
  "ai": {
    "binding": "AI"
  },

  // ============================================
  // 靜態資源 (Workers with Static Assets)
  // ============================================
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/mcp",
      "/.well-known/*",
      "/oauth/*",
      "/authorize",
      "/watch/*",
      "/progress/*",
      "/chatroom",
      "/chatroom/*",
      "/roundtable/start",
      "/models",
      "/debate",
      "/usage",
      "/self-review",
      "/github/repos",
      "/github/engineering"
    ]
  },

  // ============================================
  // 速率限制用的 KV
  // ============================================
  // 建立方式：wrangler kv namespace create "council_kv"
  // 或在 Cloudflare Dashboard → Storage & Databases → KV 手動建立，
  // 然後把拿到的 id 填進下面。
  //
  // 沒綁也不會壞：debate.js 找不到 council_kv 時會自動退化成「不限制」，
  // 但那樣公開網址就沒有防亂打的保護，建議還是綁上。
  "kv_namespaces": [
    { "binding": "council_kv", "id": "651bbecd5c8e4303a221a6ab96ea0a06" }
  ],

  // ============================================
  // 排程（Cron Triggers）
  // ============================================
  // 時間是 UTC。"0 3 * * 1" 是「每週一 03:00 UTC」（= 台灣時間週一 11:00）的自我健檢。
  // "*/2 * * * *" 是聊天室模式的 tick（每 2 分鐘檢查一次聊天室是否開著，見 src/worker.js
  // 的 scheduled() 用 event.cron 分流、src/chatroom.js 的 runChatTick）；
  // 聊天室沒開著的話，這個 tick 只是一次便宜的 KV 讀取，不會呼叫任何 AI。
  "triggers": {
    "crons": ["0 3 * * 1", "*/2 * * * *"]
  },

  // ============================================
  // Web Search（選用）
  // ============================================
  // 請用 Secret 設定：
  //   wrangler secret put GEMINI_API_KEY
  //   wrangler secret put TAVILY_API_KEY

  // ============================================
  // 自我健檢（選用；不設定的話排程跟手動端點都會直接報錯，其他功能不受影響）
  // ============================================
  // 請用 Secret 設定：
  //   wrangler secret put GITHUB_TOKEN         → GitHub Personal Access Token，
  //                                               需要對這個 repo 有 Contents + Pull requests + Issues 的讀寫權限
  //   wrangler secret put SELF_REVIEW_TOKEN    → 你自己設一組密碼，手動觸發 /self-review 時要帶這組
  // 並在下面 vars 補上：
  //   GITHUB_OWNER        → GitHub 帳號或組織名稱
  //   GITHUB_REPO         → 這個 repo 的名稱
  //   GITHUB_BASE_BRANCH  → 要開 PR 進去的分支，通常是 "main"

  // ============================================
  // MCP（選用；讓 Claude 能直接呼叫圓桌開會，不用手動開網頁）
  // ============================================
  // /mcp 端點走正規 OAuth 登入流程（Claude 連接器會自己跳出登入頁，不是貼 token 那種介面）。
  // 請用 Secret 設定：
  //   wrangler secret put MCP_TOKEN    → 你自己設一組密碼，之後 Claude 第一次連線跳出的
  //                                       登入頁，就是輸入這組密碼來「登入」；登入成功後
  //                                       Claude 會自己保管後續用的 token，不用每次手動貼。
  // 這組密碼同時也沿用給 /self-review 以外的其他用途，不設定的話 /authorize 登入頁會直接回 403。
  // OAuth 流程本身的狀態（註冊的 client、一次性 code、核發的 token）都存在上面的
  // council_kv 裡（"oauth:" 開頭的 key），沒有另外建新的 KV。
  //
  // /mcp 的 ai_council_debate_start 工具呼叫後會立刻回傳一個 /watch/:sessionId 網址，
  // 圓桌在背景討論（ctx.waitUntil）、即時進度存在同一個 council_kv 裡（"progress:" 開頭，
  // 30 分鐘沒查詢就自動過期），打開網址可以看到 A/B/最終結論陸續跑出來，不用等全部跑完。

  // ============================================
  // 環境變數
  // ============================================
  // COUNCIL_RATE_LIMIT：格式 "次數:秒數"，"30:1800" = 30 分鐘內 30 次
  // COUNCIL_ENABLED：設 "false" 可臨時休會（例如 AI 額度快用完時）
  // COUNCIL_A/B/C_PROVIDER：預設都是 "cloudflare"（免費 Workers AI 額度），
  //   /mcp 這個 MCP 工具固定用這組伺服器預設值，不會因為網頁上選了 Claude/OpenAI 就跟著變貴。
  //   想讓圓桌真的用 OpenAI／Claude 測試時，才把對應的值改成 "openai" 或 "anthropic"。
  // OPENAI_MODEL / ANTHROPIC_MODEL：沒設定時預設用 gpt-4.1-mini／claude-sonnet-4-5（較貴）；
  //   這裡先設成最輕量的版本，省測試費用，之後要測正式效果再改回去就好。
  "vars": {
    "COUNCIL_RATE_LIMIT": "30:1800",
    "COUNCIL_ENABLED": "true",
    "SELF_REVIEW_RATE_LIMIT": "1:21600",
    "COUNCIL_A_PROVIDER": "cloudflare",
    "COUNCIL_B_PROVIDER": "cloudflare",
    "COUNCIL_C_PROVIDER": "cloudflare",
    "GEMINI_MODEL": "gemini-3.5-flash",
    "OPENAI_MODEL": "gpt-4.1-nano",
    "ANTHROPIC_MODEL": "claude-haiku-4-5-20251001",
    "GITHUB_OWNER": "v25qstn7g9-prog",
    "GITHUB_REPO": "AI_Council",
    "GITHUB_BASE_BRANCH": "main",
    "GITHUB_ALLOWED_REPOS": "*"
  }
}
