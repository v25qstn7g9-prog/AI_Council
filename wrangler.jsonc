{
  "name": "ai-council",
  "compatibility_date": "2025-01-01",
  "main": "src/worker.js",

  // ============================================
  // AI 綁定 (Cloudflare AI)
  // ============================================
  // 名稱必須是 "AI"，src/debate.js 讀的是 env.AI
  "ai": {
    "binding": "AI"
  },

  // ============================================
  // 靜態資源 (Workers with Static Assets)
  // ============================================
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // ============================================
  // 速率限制用的 KV
  // ============================================
  // 建立方式：wrangler kv namespace create "council_kv"
  // 或在 Cloudflare Dashboard → Storage & Databases → KV 手動建立，
  // 然後把拿到的 id 填進下面。
  //
  // 沒綁也不會壞：debate.js 找不到 council_kv 時會自動退化成「不限制」，
  // 但那樣公開網址就沒有防亂打的保護，建議還是綁上。
  "kv_namespaces": [
    { "binding": "council_kv", "id": "651bbecd5c8e4303a221a6ab96ea0a06" }
  ],

  // ============================================
  // 自我健檢排程（Cron Trigger）
  // ============================================
  // 時間是 UTC。範例是「每週一 03:00 UTC」（= 台灣時間週一 11:00）。
  // 要改頻率就改這個 cron 字串即可，不用改程式碼。
  "triggers": {
    "crons": ["0 3 * * 1"]
  },

  // ============================================
  // Web Search（選用）
  // ============================================
  // 請用 Secret 設定：
  //   wrangler secret put GEMINI_API_KEY
  //   wrangler secret put TAVILY_API_KEY

  // ============================================
  // 自我健檢（選用；不設定的話排程跟手動端點都會直接報錯，其他功能不受影響）
  // ============================================
  // 請用 Secret 設定：
  //   wrangler secret put GITHUB_TOKEN         → GitHub Personal Access Token，
  //                                               需要對這個 repo 有 Contents + Pull requests + Issues 的讀寫權限
  //   wrangler secret put SELF_REVIEW_TOKEN    → 你自己設一組密碼，手動觸發 /self-review 時要帶這組
  // 並在下面 vars 補上：
  //   GITHUB_OWNER        → GitHub 帳號或組織名稱
  //   GITHUB_REPO         → 這個 repo 的名稱
  //   GITHUB_BASE_BRANCH  → 要開 PR 進去的分支，通常是 "main"

  // ============================================
  // 環境變數
  // ============================================
  // COUNCIL_RATE_LIMIT：格式 "次數:秒數"，"30:1800" = 30 分鐘內 30 次
  // COUNCIL_ENABLED：設 "false" 可臨時休會（例如 AI 額度快用完時）
  "vars": {
    "COUNCIL_RATE_LIMIT": "30:1800",
    "COUNCIL_ENABLED": "true",
    "COUNCIL_A_PROVIDER": "cloudflare",
    "COUNCIL_B_PROVIDER": "cloudflare",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GITHUB_OWNER": "v25qstn7g9-prog",
    "GITHUB_REPO": "AI_Council",
    "GITHUB_BASE_BRANCH": "main"
  }
}
