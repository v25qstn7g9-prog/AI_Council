{
  "name": "ai-council",
  "compatibility_date": "2025-01-01",
  "main": "src/worker.js",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "COUNCIL_RATE_LIMIT": "10:1800",
    "COUNCIL_ENABLED": "true"
  }
}
